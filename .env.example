# ---------- Telegram ----------
BOT_TOKEN=123456789:AAAbbbCCCddd
# ID адмін-групи (супергрупа з увімкненими темами/topics), формат -100xxxxxxxxxx
ADMIN_GROUP_ID=-1001234567890
# ID теми «Замовлення» в адмін-групі — туди йдуть УСІ повідомлення клієнтів,
# замовлення та квитанції. Напишіть у темі /topicid — бот покаже ID.
# Відповідь клієнту — reply на його повідомлення в цій темі.
BOT_TOPIC_ID=123

# ---------- Google Sheets (файл «Shipment_Registry») ----------
# ID таблиці — з URL: https://docs.google.com/spreadsheets/d/<ЦЕЙ_ID>/edit
GOOGLE_SHEETS_ID=1QP_eKghQSEJbGGLxkLbTUM4VYRyTR9xc7qlyeccQZHQ
# Повний вміст JSON-ключа сервіс-акаунта (ОДНИМ рядком). Сервіс-акаунт має мати
# доступ Редактора до таблиці (Поділитися → вставити client_email з ключа).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Назви вкладок усередині файлу (за замовчуванням уже правильні)
# ORDERS_SHEET_NAME=Предзамовлення
# CLIENTS_SHEET_NAME=Клієнти
# TEMPLATES_SHEET_NAME=Шаблони

# ---------- Розсилка ----------
# Тестовий режим: /mailings шле лише тому, хто набрав команду.
# Прибрати або поставити 0, щоб слати всім клієнтам.
MAILING_TEST_MODE=1

# ---------- Локальні файли ----------
# На Railway підключіть Volume на /data і розкоментуйте обидва рядки,
# інакше лічильник замовлень і звʼязки reply будуть губитись при кожному деплої.
# DB_PATH=/data/bot.db
# PENDING_PATH=/data/pending_orders.json
