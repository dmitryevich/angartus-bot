# Telegram
BOT_TOKEN=123456789:AAAbbbCCCddd
# ID адмін-групи (супергрупа з увімкненими темами/topics), формат -100xxxxxxxxxx
ADMIN_GROUP_ID=-1001234567890

# Notion (інтеграція має бути створена у workspace «Ангарта Task-Manager»
# і підключена до баз «Ангарта Operations Hub» та «Шаблони відповідей»)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx
# ID data source «Shipment Registry» (вкладка бази «Ангарта Operations Hub»)
NOTION_ORDERS_DB_ID=61c71850-0d25-422e-806e-9616588b3c6a
# ID data source бази «Шаблони відповідей»
NOTION_TEMPLATES_DB_ID=0ec0fbb7-52d8-49c4-a526-911a26662691

# ID теми «Замовлення» в адмін-групі — туди йдуть УСІ повідомлення клієнтів
# і замовлення. Напишіть у темі /topicid — бот покаже ID.
# Відповідь клієнту — reply на його повідомлення в цій темі.
BOT_TOPIC_ID=123

